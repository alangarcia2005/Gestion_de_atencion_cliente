{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "newProjectRoot": "projects",
  "projects": {
    "kiosco-restaurante": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {"builder": "@angular/build:application", "options": {"browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.app.json", "styles": ["src/styles.css"]}, "configurations": {"production": {"optimization": true, "outputHashing": "all"}, "development": {"optimization": false, "sourceMap": true}}, "defaultConfiguration": "production"},
        "serve": {"builder": "@angular/build:dev-server", "options": {"proxyConfig": "proxy.conf.json"}, "configurations": {"production": {"buildTarget": "kiosco-restaurante:build:production"}, "development": {"buildTarget": "kiosco-restaurante:build:development"}}, "defaultConfiguration": "development"}
      }
    }
  }
}
