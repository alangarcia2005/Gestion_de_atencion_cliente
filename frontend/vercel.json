{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist/kiosco-restaurante/browser",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://gestion-de-atencion-cliente-lsvf.vercel.app/api/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "https://gestion-de-atencion-cliente-lsvf.vercel.app/admin/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
