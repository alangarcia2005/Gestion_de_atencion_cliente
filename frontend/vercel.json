{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist/kiosco-restaurante/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gestion-de-atencion-cliente-lsvf.vercel.app/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://gestion-de-atencion-cliente-lsvf.vercel.app/admin/:path*"
    }
  ]
}
